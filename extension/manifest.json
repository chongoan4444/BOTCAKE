{
  "manifest_version": 3,
  "name": "Botcake Auto",
  "version": "6.0.4",
  "description": "Botcake Auto - bảng nổi kéo thả",
  "permissions": [
    "tabs",
    "storage",
    "debugger",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Botcake Auto"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "widget.js"
      ],
      "css": [
        "widget.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "widget.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}